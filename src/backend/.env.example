# ============================================== PONTOPRIME - VARIÁVEIS DE AMBIENTE
# ==============================================
# IMPORTANTE: Copie este arquivo para .env e preencha com valores reais

# DATABASE
DB_USER=pontoprime
DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
DB_NAME=pontoprime_db

# SECURITY
JWT_SECRET=change-this-secret-key-to-something-very-secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION=30

# APPLICATION
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
ALLOWED_ORIGINS=*
